<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/fg"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_tip"
            android:padding="12dp"
            android:textColor="@color/fg"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.15" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/tabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- 1: Não entendi -->
        <LinearLayout android:id="@+id/sec1" style="@style/Section">
            <TextView style="@style/Label" android:text="Cole sua frase aqui" />
            <EditText
                android:id="@+id/frase"
                style="@style/Field"
                android:gravity="top"
                android:hint="Girls make me nervous and too much attention has me shutting down"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3" />
            <TextView style="@style/Label" android:text="Digite a palavra/estrutura que não entendeu" />
            <EditText
                android:id="@+id/palavra"
                style="@style/Field"
                android:hint="shutting down"
                android:inputType="text" />
            <LinearLayout style="@style/Row">
                <Button android:id="@+id/send1" style="@style/BtnPrimary" android:text="Enviar ao ChatGPT ↗" />
                <Button android:id="@+id/copy1" style="@style/BtnSecondary" android:text="Copiar" />
            </LinearLayout>
            <TextView android:id="@+id/out1" style="@style/Preview" />
        </LinearLayout>

        <!-- 2: Organizar -->
        <LinearLayout android:id="@+id/sec2" style="@style/Section">
            <TextView
                style="@style/Hint"
                android:text="Use DEPOIS do prompt “Não entendi”, na MESMA conversa: toque em Copiar e cole no chat que já está aberto. “Novo chat” abre uma conversa nova." />
            <LinearLayout style="@style/Row">
                <Button android:id="@+id/copy2" style="@style/BtnPrimary" android:text="Copiar prompt" />
                <Button android:id="@+id/send2" style="@style/BtnSecondary" android:text="Novo chat ↗" />
            </LinearLayout>
            <TextView android:id="@+id/out2" style="@style/Preview" />
        </LinearLayout>

        <!-- 3: Exemplos -->
        <LinearLayout android:id="@+id/sec3" style="@style/Section">
            <TextView style="@style/Label" android:text="A Palavra/Estrutura" />
            <EditText
                android:id="@+id/estrutura"
                style="@style/Field"
                android:hint="shutting down"
                android:inputType="text" />
            <TextView style="@style/Label" android:text="Definição" />
            <EditText
                android:id="@+id/definicao"
                style="@style/Field"
                android:gravity="top"
                android:hint="to become quiet and withdrawn, stop responding emotionally"
                android:inputType="textMultiLine"
                android:minLines="2" />
            <TextView style="@style/Label" android:text="Quantidade de exemplos" />
            <LinearLayout
                android:id="@+id/qty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
            <LinearLayout style="@style/Row">
                <Button android:id="@+id/send3" style="@style/BtnPrimary" android:text="Enviar ao ChatGPT ↗" />
                <Button android:id="@+id/copy3" style="@style/BtnSecondary" android:text="Copiar" />
            </LinearLayout>
            <TextView android:id="@+id/out3" style="@style/Preview" />
        </LinearLayout>

        <!-- 4: Falante nativo -->
        <LinearLayout android:id="@+id/sec4" style="@style/Section">
            <TextView
                style="@style/Hint"
                android:text="O ChatGPT escolhe um assunto, puxa conversa e corrige suas frases em inglês." />
            <LinearLayout style="@style/Row">
                <Button android:id="@+id/send4" style="@style/BtnPrimary" android:text="Começar conversa ↗" />
                <Button android:id="@+id/copy4" style="@style/BtnSecondary" android:text="Copiar" />
            </LinearLayout>
            <TextView android:id="@+id/out4" style="@style/Preview" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/useApp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Abrir no app do ChatGPT (desmarcado = navegador, que envia sozinho)"
            android:textColor="@color/muted"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
